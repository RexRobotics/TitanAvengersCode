package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorSimple;

@TeleOp(name = "TeleOp_BioBuzz", group = "TeleOp")
public class TeleOp_BioBuzz extends LinearOpMode {

    DcMotor driveFL, driveFR, driveRL, driveRR;
    DcMotor intake, shooter;
    DcMotor gecko, sushi;

    @Override
    public void runOpMode() {
        driveFL = hardwareMap.get(DcMotor.class, "driveFL");
        driveFR = hardwareMap.get(DcMotor.class, "driveFR");
        driveRL = hardwareMap.get(DcMotor.class, "driveRL");
        driveRR = hardwareMap.get(DcMotor.class, "driveRR");

        intake = hardwareMap.get(DcMotor.class, "intake");
        shooter = hardwareMap.get(DcMotor.class, "shooter");
        gecko = hardwareMap.get(DcMotor.class, "gecko");
        sushi = hardwareMap.get(DcMotor.class, "sushi");

        driveFR.setDirection(DcMotorSimple.Direction.REVERSE);
        driveRR.setDirection(DcMotorSimple.Direction.REVERSE);
        gecko.setDirection(DcMotorSimple.Direction.REVERSE);
        sushi.setDirection(DcMotorSimple.Direction.REVERSE);

        driveFL.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        driveFR.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        driveRL.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        driveRR.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        waitForStart();

        while (opModeIsActive()) {
            double y = -gamepad1.left_stick_y;
            double x = gamepad1.left_stick_x;
            double rx = gamepad1.right_stick_x;

            double speed = 0.7;
            if (gamepad1.right_trigger > 0.2) {
                speed = 1.0;
            } else if (gamepad1.left_trigger > 0.2) {
                speed = 0.3;
            }

            double flPower = y + x + rx;
            double rlPower = y - x + rx;
            double frPower = y - x - rx;
            double rrPower = y + x - rx;

            double max = Math.max(Math.abs(flPower), Math.abs(rlPower));
            max = Math.max(max, Math.abs(frPower));
            max = Math.max(max, Math.abs(rrPower));

            if (max > 1.0) {
                flPower /= max;
                rlPower /= max;
                frPower /= max;
                rrPower /= max;
            }

            driveFL.setPower(flPower * speed);
            driveRL.setPower(rlPower * speed);
            driveFR.setPower(frPower * speed);
            driveRR.setPower(rrPower * speed);

            double intakePower = (gamepad1.a ? 1.0 : 0.0) - (gamepad1.b ? 1.0 : 0.0);
            intake.setPower(intakePower);

            shooter.setPower(gamepad1.x ? 1.0 : 0.0);

            double transferPower = (gamepad1.right_bumper ? 1.0 : 0.0) - (gamepad1.left_bumper ? 1.0 : 0.0);
            gecko.setPower(transferPower);
            sushi.setPower(transferPower);
        }
    }
}
